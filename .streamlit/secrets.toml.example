# Streamlit Cloud 배포용 설정 템플릿.
#
# 배포 후 앱 대시보드 → Settings → Secrets 칸에 아래 내용을 값만 채워 붙여넣는다.
# 로컬에서는 이 파일이 필요 없다. 셸 export 나 .env 로 같은 이름을 넣으면 된다.
# (실제 값이 든 secrets.toml 은 .gitignore 대상이라 저장소에 올라가지 않는다.)

UPSTAGE_API = ""
QDRANT_API_KEY = ""

# 아래는 값이 다를 때만 채운다. 비워 두면 코드의 기본값을 쓴다.
# QDRANT_URL = ""
# QDRANT_COLLECTION = "0818"
# QDRANT_VECTOR_SIZE = "4096"
